# Leave this blank for local development. Vite will use /api and proxy to the backend.
# Set this only when you have a hosted backend, for example:
# VITE_API_BASE_URL=https://your-quicksplit-api.onrender.com
VITE_API_BASE_URL=

# Hosting platforms set PORT automatically. Keep 3001 for local backend-only runs.
PORT=3001

# Use this on hosts with a persistent disk.
DATABASE_PATH=/var/data/quicksplit.db
