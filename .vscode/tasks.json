{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "QuickSplit: backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "server"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "quicksplit-backend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Backend running on http://localhost:3001"
        }
      },
      "presentation": {
        "group": "quicksplit",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "QuickSplit: frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "quicksplit-frontend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+http://localhost:5173"
        }
      },
      "presentation": {
        "group": "quicksplit",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "QuickSplit: start full app",
      "dependsOn": ["QuickSplit: backend", "QuickSplit: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
